APP_NAME=WWC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
# Basis-URL, die Agenten auf den WP-Sites verwenden (Paket-Downloads, Backup-Upload).
# Lokal (Docker): host.docker.internal erreicht die API aus dem WordPress-Container.
# Produktion: oeffentliche URL (Domain/Tunnel) eintragen.
WWC_PUBLIC_API_URL=http://host.docker.internal:8082
CORS_ALLOWED_ORIGINS=http://localhost:3000
WWC_PORTAL_URL=http://localhost:3000

# Dev-Clones: Host-Pfad des Clone-Verzeichnisses (Bind-Mounts laufen ueber den Host-Docker).
# Muss auf den Host-Pfad von apps/api/storage/app/wwc-clones zeigen.
WWC_CLONES_HOST_DIR=
# Basis-URL, unter der Clones erreichbar sind (Port wird angehaengt)
WWC_CLONE_BASE_URL=http://localhost

# Hostnamen gelten fuer den Betrieb im Docker-Compose-Stack (Services: postgres, redis, mailpit).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wwc
DB_USERNAME=wwc
DB_PASSWORD=wwc_secret

SESSION_DRIVER=database
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360
CACHE_STORE=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
